{
    "name": "bliss-web-concept/admin-kit",
    "description": "Admin screens for WordPress plugins that look and behave like WordPress: settings, lists, reports, logs, fields and services, described in PHP arrays.",
    "keywords": [
        "wordpress",
        "admin",
        "settings",
        "ui",
        "components",
        "plugin"
    ],
    "homepage": "https://github.com/blisswebconcept/admin-kit",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "support": {
        "issues": "https://github.com/blisswebconcept/admin-kit/issues",
        "source": "https://github.com/blisswebconcept/admin-kit"
    },
    "authors": [
        {
            "name": "Bliss Web Concept",
            "homepage": "https://blisswebconcept.com/"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/wordpress-stubs": "^6.8",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^1.11",
        "squizlabs/php_codesniffer": "^3.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "BlissWebConcept\\AdminKit\\": "src/"
        }
    },
    "bin": [
        "bin/bwc-build"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "analyze": "phpstan analyse --memory-limit=1G",
        "test:build": "php tests/build/run.php"
    }
}
